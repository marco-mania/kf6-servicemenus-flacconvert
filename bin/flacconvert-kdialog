#!/usr/bin/env bash
#
# Part of kf6-servicemenus-flacconvert
#
# SPDX-FileCopyrightText: 2021-2026 Marco Nelles <dev at maniatek dot de>
# SPDX-License-Identifier: GPL-3.0-or-later

readonly PROGNAME="$(basename "$0")"

# A flac decode failure must not be hidden by a "successful" exit code from
# the lame/opusenc stage reading a truncated pipe.
set -o pipefail

function help() {

    case $1 in
        en_US | *)

            echo "Convert (lossless) FLAC files to (lossy) MP3 or Opus files.

Usage: ${PROGNAME} \$command --

Commands:
    help, -h, --help
        Show this help text

    convert <\$format|custom> [\$bitrate|\$quality_preset]
        Convert audiofile(s) to the desired format. Format can be MP3 or Opus.
        Bitrate is kbps. If you select custom format you must not set the
        bitrate.
        Quality presets for LAME:
          7 (~100 kbps)
          6 (~115 kbps)
          5 (~130 kbps, transparent for a majority users)
          4 (~165 kbps, transparent for most users)
          3 (~175 kbps)
          2 (~190 kbps, transparent)
          1 (~225 kbps)
          0 (~245 kbps)
        Bitrate range for Opus (kbps): 5-510

Examples:
    ${PROGNAME} convert mp3 0 /path/to/song1.flac
    ${PROGNAME} convert opus 128 /path/to/song1.flac /path/to/song2.flac
    ${PROGNAME} convert custom /path/to/song1.flac /path/to/song2.flac
"

    esac

}

## language

function load_lang() {

    case $1 in
        en_US | *)

            msg_common_dependency_check_failed_title="Dependency check failed"
            msg_common_kdialog_not_found_text="kdialog not found. Assuming KDE environment."
            msg_common_flac_not_found_text="FLAC not found."
            msg_common_metaflac_not_found_text="metaflac not found."
            msg_common_lame_not_found_text="LAME not found."
            msg_common_opus_not_found_text="opus-tools not found."
            msg_common_qdbus_not_found_text="qdbus (or qdbus6) not found."

            msg_common_abort="Operation interrupted by user."
            msg_common_overwrite_text="An output file with this name may already exist. Do you want to overwrite it? Otherwise a new file with a filename suffix will be created. (The source FLAC file is never touched.)"
            msg_common_overwrite_yes="YES, OVERWRITE"
            msg_common_overwrite_no="No, create new files"
            msg_common_progress_text="Processing file \$i of \$file_count \(\$basename_file\)"
            msg_common_start="Starting."
            msg_common_finish_ok="Done."
            msg_common_finish_error="An error has occurred."
            msg_common_file_not_found="File \$basename_file not found."
            msg_common_command_not_found_text="The requested command \$command is not implemented."

            msg_convert_title="Conversion of audio files"
            msg_convert_format_input_text="Choose the format you want:"
            msg_convert_bitrate_input_text="Choose the bitrate in kbps:"
            msg_convert_qualitypreset_input_text="Choose the quality preset:\n(*) transparent"
            msg_convert_finish_title="Conversion of \$basename_file"

            ;;
    esac

}

load_lang ${LANGUAGE%%:*}

## check dependencies

kdialog_bin=$(command -v kdialog)
if [ -z "${kdialog_bin}" ]; then
    echo "${msg_common_kdialog_not_found_text}"
    exit 2
fi

flac_bin=$(command -v flac)
if [ -z "${flac_bin}" ]; then
    "${kdialog_bin}" --icon configure --title "${msg_common_dependency_check_failed_title}" --error "${msg_common_flac_not_found_text}"
    exit 2
fi

metaflac_bin=$(command -v metaflac)
if [ -z "${metaflac_bin}" ]; then
    "${kdialog_bin}" --icon configure --title "${msg_common_dependency_check_failed_title}" --error "${msg_common_metaflac_not_found_text}"
    exit 2
fi

lame_bin=$(command -v lame)
if [ -z "${lame_bin}" ]; then
    "${kdialog_bin}" --icon configure --title "${msg_common_dependency_check_failed_title}" --error "${msg_common_lame_not_found_text}"
    exit 2
fi

opusenc_bin=$(command -v opusenc)
if [ -z "${opusenc_bin}" ]; then
    "${kdialog_bin}" --icon configure --title "${msg_common_dependency_check_failed_title}" --error "${msg_common_opus_not_found_text}"
    exit 2
fi

qdbus_bin=$(command -v qdbus)
if [ -z "${qdbus_bin}" ]; then
    qdbus_bin=$(command -v qdbus6)
    if [ -z "${qdbus_bin}" ]; then
        "${kdialog_bin}" --icon configure --title "${msg_common_dependency_check_failed_title}" --error "${msg_common_qdbus_not_found_text}"
        exit 2
    fi
fi

# optional, for cover-art post-processing (resize/reencode/strip) only
mogrify_bin=$(command -v mogrify)
magick_bin=$(command -v magick)

# Runs ImageMagick regardless of whether only the IM7+ "magick" binary or
# the legacy standalone "mogrify" is installed. No-op if neither is present.
run_mogrify() {
    if [ -n "${magick_bin}" ]; then
        "${magick_bin}" mogrify "$@"
    elif [ -n "${mogrify_bin}" ]; then
        "${mogrify_bin}" "$@"
    fi
}

## exec functions

exec_convert () {

    local inputfile="$1"
    local format="$FORMAT"
    local bitrate=$BITRATE

    local dir=$(dirname -- "${inputfile}")
    local name="${inputfile##*/}"
    local base="${name%.*}"
    local ext="${name##*.}"

    local outputfile
    if [ "${overwrite}" = true ]; then
        outputfile="${dir}/${base}.${format}"
    else
        outputfile="${dir}/${base}_${bitrate}.${format}"
    fi

    # get the tags
    local artist=$("${metaflac_bin}" "${inputfile}" --show-tag=artist | sed 's/^[^=]*=//')
    local title=$("${metaflac_bin}" "${inputfile}" --show-tag=TITLE | sed 's/^[^=]*=//')
    local album=$("${metaflac_bin}" "${inputfile}" --show-tag=ALBUM | sed 's/^[^=]*=//')
    local genre=$("${metaflac_bin}" "${inputfile}" --show-tag=GENRE | sed 's/^[^=]*=//')
    local tracknum=$("${metaflac_bin}" "${inputfile}" --show-tag=TRACKNUMBER | sed 's/^[^=]*=//')
    local date=$("${metaflac_bin}" "${inputfile}" --show-tag=DATE | sed 's/^[^=]*=//')

    # Get the cover and, in a single pass, resize/reencode/strip it to a
    # small JPEG. The temp file is created with a .jpg suffix up front (not
    # via the race-prone "mktemp -u") so that one "-format jpg" call also
    # converts a non-JPEG (e.g. PNG) embedded cover in place, instead of
    # silently writing an orphaned sibling file that was never used.
    #
    # Cover handling is entirely gated on ImageMagick being available: an
    # embedded cover can easily be several MB unprocessed (a multi-megapixel
    # PNG, say), which would defeat the point of a lossy conversion. Without
    # ImageMagick to shrink/reencode it, skip the cover rather than embed it
    # raw.
    cover_filename=""
    if [ -n "${magick_bin}" ] || [ -n "${mogrify_bin}" ]; then
        cover_filename="$(mktemp --suffix=.jpg)"
        "${metaflac_bin}" --export-picture-to="${cover_filename}" "${inputfile}" 2>/dev/null
        if [ -s "${cover_filename}" ]; then
            run_mogrify -resize 1000 -filter Triangle -define filter:support=2 -unsharp 0.25x0.25+8+0.065 -dither None -posterize 136 -quality 82 -define jpeg:fancy-upsampling=off -colorspace sRGB -strip -interlace Plane -format jpg "${cover_filename}"
        else
            rm -f "${cover_filename}"
            cover_filename=""
        fi
    fi

    if [ "$format" == "mp3" ]; then
        if [ -n "${cover_filename}" ]; then
            OUTPUT=$("${flac_bin}" -s -c -d "${inputfile}" 2>&1 | "${lame_bin}" -V ${bitrate} --add-id3v2 --pad-id3v2 --ignore-tag-errors --ta "${artist}" --tt "${title}" --tl "${album}"  --tg "${genre:-12}" --tn "${tracknum:-0}" --ty "${date}" --ti "${cover_filename}" - "${outputfile}" 2>&1)
        else
            OUTPUT=$("${flac_bin}" -s -c -d "${inputfile}" 2>&1 | "${lame_bin}" -V ${bitrate} --add-id3v2 --pad-id3v2 --ignore-tag-errors --ta "${artist}" --tt "${title}" --tl "${album}"  --tg "${genre:-12}" --tn "${tracknum:-0}" --ty "${date}" - "${outputfile}" 2>&1)
        fi
    elif [ "$format" == "opus" ]; then
        if [ -n "${cover_filename}" ]; then
            OUTPUT=$("${flac_bin}" -s -c -d "${inputfile}" 2>&1 | "${opusenc_bin}" --bitrate ${bitrate} --downmix-stereo --artist "${artist}" --title "${title}" --album "${album}" --genre "${genre}" --comment "TRACKNUMBER=${tracknum}" --date "${date}" --picture "${cover_filename}" - "${outputfile}" 2>&1)
        else
            OUTPUT=$("${flac_bin}" -s -c -d "${inputfile}" 2>&1 | "${opusenc_bin}" --bitrate ${bitrate} --downmix-stereo --artist "${artist}" --title "${title}" --album "${album}" --genre "${genre}" --comment "TRACKNUMBER=${tracknum}" --date "${date}" - "${outputfile}" 2>&1)
        fi
    fi

    local rc=$?

    if [ -n "${cover_filename}" ]; then
        rm -f "${cover_filename}"
    fi

    return $rc

}

overwrite_question() {

    "${kdialog_bin}" --icon configure --title "${msg_title}" --dontagain servicemenus-flacconvert:nooverwritemsg --warningyesno "${msg_common_overwrite_text}" --yes-label "${msg_common_overwrite_no}" --no-label "${msg_common_overwrite_yes}"
    rc=$?

    if [ $rc -eq 1 ]; then
        overwrite=true
    else
        if [ $rc -eq 0 ]; then
            overwrite=false
        else
            {
                "${kdialog_bin}" --title "${msg_title}" --passivepopup "${msg_common_abort}" 5
                exit 2
            }
        fi
    fi

}

iterate_files () {

    if [ "${flag_ask_overwrite}" = true ]; then
        # Only ask if an actual output file (base name + *target* extension,
        # e.g. "song.mp3"/"song.opus" - never the source "song.flac" itself)
        # already exists for one of the selected files. Otherwise there is
        # nothing to overwrite and asking is just a false "this already
        # exists" alarm.
        local any_collision=false
        local check_file candidate_dir candidate_base
        for check_file in "$@"; do
            candidate_dir=$(dirname -- "${check_file}")
            candidate_base="${check_file##*/}"
            candidate_base="${candidate_base%.*}"
            if [ -f "${candidate_dir}/${candidate_base}.${FORMAT}" ]; then
                any_collision=true
                break
            fi
        done

        if [ "${any_collision}" = true ]; then
            overwrite_question
        else
            overwrite=true
        fi
    fi

    file_count=$#
    dbus_ref=$(kdialog --icon configure --title "${msg_title}" --progressbar "${msg_common_start}" $file_count)
    ${qdbus_bin} $dbus_ref org.kde.kdialog.ProgressDialog.showCancelButton true
    i=1

    while [[ "false" == "$(${qdbus_bin} $dbus_ref org.kde.kdialog.ProgressDialog.wasCancelled 2>/dev/null)" && $i -le $file_count ]]; do

        local file="${!i}"
        local basename_file="$(basename "$file")"

        if [ ! -f "${file}" ]; then
            "${kdialog_bin}" --icon configure --title "${msg_title}" --error "$(eval echo "${msg_common_file_not_found}")"
            ${qdbus_bin} $dbus_ref close 2>/dev/null
            exit 2
        fi
        ${qdbus_bin} $dbus_ref org.kde.kdialog.ProgressDialog.setLabelText "$(eval echo "${msg_common_progress_text}")"
        msg_finish_title="$(eval echo "${msg_convert_finish_title}")"

        case $command in
        convert)
            exec_convert "${file}"
            ;;
        esac

        rc=$?
        if [ $rc -eq 0 ]; then
            "${kdialog_bin}" --title "${msg_finish_title}" --passivepopup "${msg_common_finish_ok}" 5
        else
            ${qdbus_bin} $dbus_ref close 2>/dev/null
            "${kdialog_bin}" --icon configure --title "${msg_finish_title}" --detailederror "${msg_common_finish_error}" "${OUTPUT}"
            exit 2
        fi

        ${qdbus_bin} $dbus_ref org.freedesktop.DBus.Properties.Set org.kde.kdialog.ProgressDialog value $i

        i=$(($i + 1))

    done

    ${qdbus_bin} $dbus_ref close 2>/dev/null

}

## init functions

init_convert () {

    local value="${1}"
    shift

    if [ "${value}" == "custom" ]; then
        FORMAT=$("${kdialog_bin}" --icon configure --title "${msg_title}" --combobox "${msg_convert_format_input_text}" "mp3" "opus" --default "mp3") || \
            { "${kdialog_bin}" --title "${msg_title}" --passivepopup "${msg_common_abort}" 5 && exit 2; }
        if [ "$FORMAT" == "mp3" ]; then
          BITRATE=$("${kdialog_bin}" --icon configure --title "${msg_title}" --combobox "${msg_convert_qualitypreset_input_text}" "7 (~100 kbps)" "6 (~115 kbps)" "5 (~130 kbps)" "4 (~165 kbps)" "3 (~175 kbps)" "2 (~190 kbps)(*)" "1 (~225 kbps)" "0 (~245 kbps)" --default "2 (~190 kbps)(*)") || \
            { "${kdialog_bin}" --title "${msg_title}" --passivepopup "${msg_common_abort}" 5 && exit 2; }
          BITRATE=${BITRATE:0:1}
        else
          BITRATE=$("${kdialog_bin}" --icon configure --title "${msg_title}" --inputbox "${msg_convert_bitrate_input_text}") || \
            { "${kdialog_bin}" --title "${msg_title}" --passivepopup "${msg_common_abort}" 5 && exit 2; }
        fi
    else
        FORMAT="${value}"
        BITRATE="${1}"
        shift
    fi

    flag_ask_overwrite=true
    iterate_files "${@}"

}


## main part

command="${1}"
shift

flag_ask_overwrite=false

if [ -z "$command" ]; then
    help ${LANGUAGE%%:*}
    exit 0
fi

case $command in
help | -h | --help)
    help
    exit 0
    ;;
convert)
    msg_title="$msg_convert_title"
    init_convert "${@}"
    ;;
*)
    "${kdialog_bin}" --icon configure --title "${msg_common_dependency_check_failed_title}" --error "$(eval echo "${msg_common_command_not_found_text}")"
    exit 2
    ;;
esac

exit 0
